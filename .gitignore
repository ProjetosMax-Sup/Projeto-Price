# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# cadastros de Parâmetros (Lojas/Departamentos/Dicionário) — estado local editável
# pela própria plataforma, não código-fonte (ver lib/parametros/store.ts)
/data/parametros/

# arquivos removidos na conversão pra app 100% local (ver CLAUDE.md) — mantidos aqui
# só de cautela, não fazem mais parte do projeto; pode apagar a pasta inteira quando
# tiver confirmado que a conversão está OK.
/_arquivado-conversao-local/

# ferramentas locais (harness do Claude Code, etc.)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
teste-datas.mjs
teste-*.mjs
screenshots-teste/
