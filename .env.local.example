# ── Desenvolvimento local ────────────────────────────────────────────────
# Caminho da pasta OneDrive com os arquivos-fonte (difere entre computador
# pessoal e notebook corporativo — copiar para .env.local e ajustar).
DESEMPENHO_COMERCIAL_DATA_DIR=C:\caminho\para\a\pasta\com\os\bdDesempenhoComercial...

# ── Produção (Vercel) ────────────────────────────────────────────────────
# Login é senha única do site (proxy.ts) — sem essa variável configurada, o
# proxy não bloqueia nada (comportamento de dev). Já está cadastrada na
# Vercel de produção.
# SITE_PASSWORD=

# App registrado em portal.azure.com > App registrations — permite o site ler
# os arquivos direto do OneDrive sem a pasta local. Ver checklist no README.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Pasta no OneDrive (relativa à raiz da conta) com os arquivos — só precisa
# mudar se o nome/local da pasta "05 - Bases" for diferente em produção.
# ONEDRIVE_BASES_FOLDER=05 - Bases

# Redis — guarda o token de acesso ao OneDrive, o cadastro de Parâmetros
# (Lojas/Departamentos/Usuários) e o dataset processado do Desempenho
# Comercial (cache que o cron diário escreve). Não é opcional na prática:
# sem ele, toda leitura cai no fallback lento de ler/parsear os TXT direto do
# OneDrive a cada request.
REDIS_URL=

# ⚠️ Plano atual do Redis (free/pequeno) não aguenta o dataset completo (9+
# meses, 4+ milhões de registros) — dá OOM na escrita do cache. Enquanto isso
# não for resolvido (upgrade de plano, ou mover esse cache pra um banco de
# verdade), restringe quais meses processar. Ver CLAUDE.md > Deploy.
MESES_HABILITADOS=Julho,Agosto,Setembro

# Opcional: protege /api/cron/atualizar-dados contra chamada por qualquer um
# que descubra a URL (a Vercel manda esse valor no header Authorization
# automaticamente pros crons dela — só precisa cadastrar o mesmo valor aqui).
# CRON_SECRET=

# ── Login individual (Clerk) — PAUSADO, ver CLAUDE.md > Stack técnica ──────
# Construído mas desligado do fluxo de acesso (lib/auth/usuario-atual.ts
# devolve um usuário sintético com acesso total em vez de checar o Clerk).
# Clerk exige domínio próprio pra rodar em modo Production; o app hoje só usa
# o domínio *.vercel.app compartilhado. Só necessário reativar quando tiverem
# domínio e decidirem retomar login individual — não precisa configurar pra
# rodar o app hoje.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (projeto "Analitycs", dashboard.supabase.com > Settings > API) —
# usado só pelo pipeline de Entradas/Saídas (lib/entradas-saidas/), separado
# do Desempenho Comercial (que continua no Redis). SERVICE_ROLE_KEY é a
# chave secreta ("service_role"), nunca a "anon"/publishable.
# Nenhuma rota/cron chama esse pipeline hoje (nem /entradas-saidas, que é só
# um stub de página) — só existe o loader em si, ainda não plugado em nada.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
